{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"],
      "@common/*": ["../../common/src/*"],
      "@injected/*": ["./src/*"]
    }
  },
  "include": ["src", "../../common/**/**.d.ts"],
  "references": [
    {
      "path": "../../common"
    }
  ]
}
