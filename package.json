{
  "name": "@contacts/frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "common"
  ],
  "scripts": {
    "start:private": "npm run start -w @contacts/private",
    "build": "npm run build:private",
    "build:private": "npm run build -w @contacts/private",
    "serve:private": "npx serve -s apps/private/dist -l 5000",
    "test": "vitest run",
    "lint": "rs lint apps common",
    "lint:fix": "rs lint --fix apps common && rs fmt",
    "lint:fmt": "rs fmt --check",
    "fmt": "rs fmt",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:deps": "syncpack lint --dependency-types prod,dev,peer"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-stylus": "^2.0.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^26.1.0",
    "rslint-config-cozy-app": "^0.2.0",
    "rstack": "0.8.6",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "typescript": "$typescript",
    "@babel/runtime": "^7.26.0",
    "js-yaml": "^4.1.0"
  }
}
