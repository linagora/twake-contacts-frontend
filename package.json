    "jest-environment-jsdom": "^30.2.0",
    "rslint-config-cozy-app": "^0.2.0",
    "rstack": "0.8.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "typescript": "$typescript",
