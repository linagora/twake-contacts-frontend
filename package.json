    "@linagora/twake-mui": "^18.4.1",
    "@linagora/twake-oidc": "^1.3.0",
    "@linagora/twake-sdk": "^1.1.0",
    "@linagora/twake-utils": "^1.2.0",
    "@linagora/twake-websocket": "^1.2.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react": "^8.55.1",
    "date-fns": "^4.1.0",
    "history": "^5.3.0",
